def get_yolo_nano_predictions(X_scaled):
    # Simulate YOLO Nano predictions with its typical accuracy
    # This should be replaced with actual inference from a trained YOLO Nano model
    np.random.seed(42)
    # Assuming 3 classes, generate probabilities that sum to 1
    probs = np.random.rand(len(X_scaled), 3)
    # Artificially boost accuracy for one class for demonstration
    for i in range(len(X_scaled)):
        if np.random.rand() < 0.85: # Simulate 85% accuracy
            probs[i, np.random.randint(0, 3)] += 1.0 # Ensure one class is preferred
    probs = probs / probs.sum(axis=1, keepdims=True)
    return np.argmax(probs, axis=1)

