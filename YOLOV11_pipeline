import os
import pandas as pd
from sklearn.model_selection import train_test_split
import shutil
from ultralytics import YOLO
from PIL import Image
import numpy as np
from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, accuracy_score
import matplotlib.pyplot as plt
from torch.utils.data import Dataset # Import Dataset for YOLOClassificationDataset


# Define paths and configurations (should be consistent with main_pipeline)
DATASET_PATH = '/content/Dataset_BUSI_with_GT'
YOLO_DATA_ROOT = '/content/yolo_busi_dataset'
CLASS_NAMES_MAP = {0: 'normal', 1: 'benign', 2: 'malignant'}
CLASS_LABELS = ['normal', 'benign', 'malignant']

class YOLOClassificationDataset(Dataset):
    def __init__(self, root_dir, class_names, transform=None):
        self.root_dir = root_dir
        self.class_names = class_names
        self.transform = transform
        self.samples = []

        self.class_to_idx = {name: idx for idx, name in enumerate(class_names)}

        for class_name in class_names:
            class_path = os.path.join(root_dir, class_name)
            if os.path.exists(class_path):
                for img_name in os.listdir(class_path):
                    img_path = os.path.join(class_path, img_name)
                    self.samples.append((img_path, self.class_to_idx[class_name]))

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        img_path, label = self.samples[idx]
        image = Image.open(img_path).convert("RGB")
        if self.transform:
            image = self.transform(image)
        return image, label, img_path

def prepare_yolo_dataset(df_full):
    print("--- Preparing Dataset for YOLO Classification ---")

    if os.path.exists(YOLO_DATA_ROOT):
        shutil.rmtree(YOLO_DATA_ROOT)
        print(f"Cleared existing directory: {YOLO_DATA_ROOT}")

    for split_type in ['train', 'val']:
        for class_name in CLASS_LABELS:
            os.makedirs(os.path.join(YOLO_DATA_ROOT, split_type, class_name), exist_ok=True)
    print("YOLO dataset directory structure created.")

    all_image_paths = []
    all_labels = []
    for index, row in df_full.iterrows():
        class_name = CLASS_NAMES_MAP[row['label']]
        original_path = os.path.join(DATASET_PATH, class_name, row['image_name'])
        if os.path.exists(original_path):
            all_image_paths.append(original_path)
            all_labels.append(row['label'])
        else:
            print(f"Warning: Original image not found at {original_path}. Skipping.")

    train_paths, val_paths, train_labels, val_labels = train_test_split(
        all_image_paths, all_labels, test_size=0.2, random_state=42, stratify=all_labels
    )

    def copy_images(image_list, labels_list, split_type, dest_root):
        for i, path in enumerate(image_list):
            original_class_name = CLASS_NAMES_MAP[labels_list[i]]
            dest_dir = os.path.join(dest_root, split_type, original_class_name)
            shutil.copy(path, dest_dir)

    copy_images(train_paths, train_labels, 'train', YOLO_DATA_ROOT)
    copy_images(val_paths, val_labels, 'val', YOLO_DATA_ROOT)

    dataset_yaml_content = f"""
path: {YOLO_DATA_ROOT}
train: train
val: val
names:
  0: normal
  1: benign
  2: malignant
"""
    yaml_path = os.path.join(YOLO_DATA_ROOT, 'dataset.yaml')
    with open(yaml_path, 'w') as f:
        f.write(dataset_yaml_content)
    print(f"YOLO dataset preparation complete at {YOLO_DATA_ROOT}")

def train_yolo_model(epochs=30, imgsz=224, patience=10, name='yolo11s_busi_tuned'):
    print(f"\n--- Training YOLO11 Small model with {epochs} epochs ---")
    model = YOLO('yolo11s-cls.pt')
    results = model.train(
        data=YOLO_DATA_ROOT,
        epochs=epochs,
        imgsz=imgsz,
        patience=patience,
        seed=42,
        plots=True,
        name=name
    )
    yolo_model_path = os.path.join(results.save_dir, 'weights', 'best.pt')
    yolo_accuracy = results.metrics['top1'] * 100
    print(f"YOLO11 Small Top-1 Accuracy: {yolo_accuracy:.2f}%")
    return yolo_accuracy, yolo_model_path, results

def evaluate_yolo_model(model_path, yolo_data_root_val_split):
    print("\n--- Evaluating YOLO Model on Validation Set ---")
    model = YOLO(model_path)
    class_names_eval = [CLASS_NAMES_MAP[i] for i in sorted(CLASS_NAMES_MAP.keys())]
    yolo_val_dataset = YOLOClassificationDataset(os.path.join(yolo_data_root_val_split, 'val'), class_names=class_names_eval)

    true_labels = []
    predictions = []

    for idx, (image, true_label, img_path) in enumerate(yolo_val_dataset):
        results = model.predict(img_path, verbose=False)
        probs = results[0].probs
        predicted_class_idx = probs.top1

        true_labels.append(true_label)
        predictions.append(predicted_class_idx)

    cm = confusion_matrix(true_labels, predictions, labels=sorted(CLASS_NAMES_MAP.keys()))
    accuracy = accuracy_score(true_labels, predictions) * 100

    disp = ConfusionMatrixDisplay(confusion_matrix=cm,
                                   display_labels=[c.capitalize() for c in class_names_eval])
    fig, ax = plt.subplots(figsize=(8, 6))
    disp.plot(cmap='Blues', ax=ax)
    ax.set_title(f'YOLO11 Small Confusion Matrix (Validation, {accuracy:.1f}%)')
    plt.tight_layout()
    plt.savefig('yolo11_confusion_matrix.png', dpi=150)
    plt.close(fig)
    print(f"Saved: yolo11_confusion_matrix.png with accuracy {accuracy:.2f}%")

    print("\n--- Overall Misclassification Patterns for YOLO Model ---")
    for i, true_class in enumerate(class_names_eval):
        for j, predicted_class in enumerate(class_names_eval):
            if i != j:
                count = cm[i, j]
                if count > 0:
                    print(f"  True {true_class.capitalize()} often misclassified as {predicted_class.capitalize()}: {count} instances")
    return accuracy